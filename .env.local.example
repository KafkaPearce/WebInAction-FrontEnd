# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
#
# LARAVEL_API_URL = base URL Laravel (server-side saja, JANGAN pakai NEXT_PUBLIC_*).
#   - Tanpa "/api", karena route handler menambahkan "/api/" sendiri.
#   - Tanpa trailing slash.
#   - Wajib HTTPS saat production.
#
# Default lokal:
LARAVEL_API_URL=http://127.0.0.1:8000
